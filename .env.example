# EviRep environment variables — copy to .env and fill in. NEVER commit .env
# (.gitignore already excludes it).
#
# All of these are OPTIONAL. Every API used by this pipeline is callable
# unauthenticated; keys only raise rate limits.

# NCBI E-utilities key (script 04, literature independence).
# Raises the PubMed rate limit from 3 to 10 requests/second.
# Obtain from: https://account.ncbi.nlm.nih.gov/settings/
NCBI_API_KEY=

# NOTE: the Molecular / Pathway Agent (scripts/molecular_agent.py,
# scripts/08_molecular_pathway.py) uses the Open Targets Platform GraphQL API,
# which requires NO authentication. No key is read, and none should be added.
# ClinicalTrials.gov v2, openFDA and Semantic Scholar are likewise called
# unauthenticated by scripts 03/05/04.
