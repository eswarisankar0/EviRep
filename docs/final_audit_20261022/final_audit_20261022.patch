+
+    def test_writers_create_data_dir(self):
+        for rel in ("scripts/00_exclusion_filter.py", "scripts/01_get_pd_candidates.py", "scripts/check_studytype.py"):
+            with open(os.path.join(ROOT, rel), encoding="utf-8") as fh:
