+class TestHighestPhase(unittest.TestCase):
+    """Stage 03 stored phases[0]: a PHASE2/PHASE3 trial was recorded as PHASE2 (18 pre-cutoff links, 6 compounds)."""
+
+    def test_highest_listed_phase(self):
+        m = _load("ct03", "scripts/03_clinicaltrials_groundtruth.py")
+        self.assertEqual(m.highest_phase(["PHASE2", "PHASE3"]), "PHASE3")
+        self.assertEqual(m.highest_phase(["EARLY_PHASE1"]), "EARLY_PHASE1")
+        self.assertEqual(m.highest_phase(["PHASE1", "PHASE2"]), "PHASE2")
+        self.assertEqual(m.highest_phase([]), "NA")
+        self.assertEqual(m.highest_phase(None), "NA")
+        self.assertEqual(m.highest_phase(["NA"]), "NA")
+        self.assertEqual(m.highest_phase(["UNKNOWN_VALUE", "PHASE1"]), "PHASE1")
