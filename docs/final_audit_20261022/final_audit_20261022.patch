+@unittest.skipUnless(HAVE, "needs the approved artefacts")
+class TestVerifierMatchesStage06ForAbsentMolecular(unittest.TestCase):
+    """A pool compound absent from molecular_pathway.csv is median-imputed by stage 06 (DECISIONS D-004); the verifier
+    gave it 0.5, so such a cohort failed verification although stage 06 was right (rebuilt cohort, 2026-10-22)."""
+
+    def test_absent_compound_gets_the_pool_median_raw_score(self):
+        v = _load("vv_absent", "scripts/vps_verify.py")
+        tmp = tempfile.mkdtemp(prefix="evirep_absent_")
+        try:
+            os.makedirs(os.path.join(tmp, "data"))
+            for f in INPUTS:
+                shutil.copy(os.path.join(ROOT, "data", f), os.path.join(tmp, "data", f))
+            import pandas as pd
+            m = pd.read_csv(os.path.join(tmp, "data", "molecular_pathway.csv"))
+            gone = m[m.n_targets > 0].compound_name.iloc[0]
+            m[m.compound_name != gone].to_csv(os.path.join(tmp, "data", "molecular_pathway.csv"), index=False)
+            expected, _ = v.recompute(tmp)
+            raw = m[m.compound_name != gone].molecular_plausibility_score
+            med = float(raw.median())
+            vals = sorted(raw.where(m[m.compound_name != gone].n_targets > 0).dropna().tolist() + [med])
+            # rank of the median among measured values (legacy: average rank / n)
+            le = [i + 1 for i, x in enumerate(vals) if x == med]
+            self.assertAlmostEqual(expected[gone]["r_molecular"], (sum(le) / len(le)) / len(vals), places=12)
+            self.assertNotEqual(expected[gone]["r_molecular"], 0.5)
+        finally:
+            shutil.rmtree(tmp, ignore_errors=True)
