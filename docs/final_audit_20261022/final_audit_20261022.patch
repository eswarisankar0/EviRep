+"""Regression tests for defects fixed in the final audit (2026-10-22)."""
+import importlib.util
+import json
+import os
+import runpy
+import shutil
+import sys
+import tempfile
+import unittest
+from unittest import mock
+
+ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+sys.path.insert(0, os.path.join(ROOT, "scripts"))
+
+
+def _load(name, rel):
+    spec = importlib.util.spec_from_file_location(name, os.path.join(ROOT, rel))
+    mod = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(mod)
+    return mod
+
+
+HAVE = os.path.exists(os.path.join(ROOT, "data", "vps_scores_v2.csv"))
+INPUTS = ["pd_candidates_filtered.csv", "network_proximity.csv", "clinical_maturity_precutoff_clean.csv",
+          "literature_independence.csv", "safety_signal.csv", "ground_truth_postcutoff_clean.csv",
+          "label_role_exclusions.csv", "molecular_pathway.csv"]
+
+
+@unittest.skipUnless(HAVE, "needs the approved artefacts")
+class TestVerifierAppliesFeatureExclusions(unittest.TestCase):
+    """vps_verify built the pool without data/feature_role_exclusions.csv, so adopting D-020 would have made the
+    independent check fail although stage 06 was right."""
+
+    def setUp(self):
+        self.tmp = tempfile.mkdtemp(prefix="evirep_fx_")
+        os.makedirs(os.path.join(self.tmp, "data"))
+        for f in INPUTS:
+            shutil.copy(os.path.join(ROOT, "data", f), os.path.join(self.tmp, "data", f))
+        self.v = _load("vv_fx", "scripts/vps_verify.py")
+
+    def tearDown(self):
+        shutil.rmtree(self.tmp, ignore_errors=True)
+
+    def _fx(self, rows):
+        with open(os.path.join(self.tmp, "data", "feature_role_exclusions.csv"), "w") as fh:
+            fh.write("nct_id,compound_name\n" + "".join(f"{n},{c}\n" for n, c in rows))
+
+    def test_a_compound_with_no_remaining_link_leaves_the_pool(self):
+        self._fx([("NCT02236260", "Lidocaine")])                       # Lidocaine's only pre-cutoff link
+        expected, _ = self.v.recompute(self.tmp)
+        self.assertNotIn("Lidocaine", expected)
+        self.assertEqual(len(expected), 89)
+
+    def test_unknown_exclusion_is_an_error(self):
+        self._fx([("NCT00000000", "Lidocaine")])
+        with self.assertRaises(ValueError):
+            self.v.recompute(self.tmp)
+
+    def test_no_file_means_the_approved_pool(self):
+        expected, _ = self.v.recompute(self.tmp)
+        self.assertEqual(len(expected), 90)
+
+
+class TestAgentExitCodes(unittest.TestCase):
+    """10d, 10e and 10h exited 0 even when they wrote run_status FAILED; now exit 1 only on FAILED."""
+
+    def _run(self, rel, status, extra):
+        mod = _load("agent_" + os.path.basename(rel)[:-3], rel)
+        tmp = tempfile.mkdtemp(prefix="evirep_exit_")
+        os.makedirs(os.path.join(tmp, "data"))
+        try:
+            out = {"run_status": status, **extra}
+            with mock.patch.object(mod, "run", return_value=out), mock.patch.object(mod, "validate_output"):
+                return mod.main(["--root", tmp])
+        finally:
+            shutil.rmtree(tmp, ignore_errors=True)
+
+    def test_conflict_context_10d(self):
+        e = {"records": [], "status_counts": {}}
+        self.assertEqual(self._run("scripts/conflict_context_agent.py", "FAILED", e), 1)
+        self.assertEqual(self._run("scripts/conflict_context_agent.py", "PARTIAL", e), 0)
+        self.assertEqual(self._run("scripts/conflict_context_agent.py", "SUCCESS", e), 0)
+
+    def test_reproducibility_10e(self):
+        e = {"findings": [], "finding_status_counts": {}, "publication_structures": [], "shared_trials_across_compounds": {}}
+        self.assertEqual(self._run("scripts/reproducibility_agent.py", "FAILED", e), 1)
+        self.assertEqual(self._run("scripts/reproducibility_agent.py", "SUCCESS", e), 0)
+
+    def test_completeness_10h(self):
+        mod = _load("cg_dims", "scripts/completeness_gap_agent.py")
+        e = {"records": [], "synthesis_inputs": [], "stage06_agreement": True,
+             "state_counts_by_domain": {d: {} for d in mod.VPS_DIMS}}
+        self.assertEqual(self._run("scripts/completeness_gap_agent.py", "FAILED", e), 1)
+        self.assertEqual(self._run("scripts/completeness_gap_agent.py", "SUCCESS", e), 0)
+
+    def test_main_guards_propagate_the_exit_code(self):
+        for rel in ("scripts/conflict_context_agent.py", "scripts/reproducibility_agent.py"):
+            with open(os.path.join(ROOT, rel), encoding="utf-8") as fh:
+                self.assertIn("raise SystemExit(main())", fh.read(), rel)
+
+
+class TestEveryStageHasATimeout(unittest.TestCase):
